@model List<Producto>

<h2 class="text-primary mb-4">Lista de Productos</h2>

<table class="table table-striped table-bordered table-hover shadow-sm">
    <thead class="table-dark text-uppercase">
        <tr>
            <th scope="col" hidden>#ID</th>
            <th scope="col">Descripción</th>
            <th scope="col">Precio</th>
            @if ((bool)ViewData["esAdmin"])
            {
                <th scope="col" class="text-center">Acciones</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var producto in Model)
        {
            <tr>
                <th scope="row" hidden class="text-center text-primary">@producto.IdProducto</th>
                <td>@producto.Descripcion</td>
                <td>$@producto.Precio.ToString("F2")</td>
                @if ((bool)ViewData["esAdmin"])
                {
                    <td class="text-center">
                        <a asp-controller="Producto" asp-action="ModificarProducto" asp-route-id="@producto.IdProducto"
                            class="btn btn-warning btn-sm mx-1">
                            <i class="bi bi-pencil-square"></i> Editar
                        </a>
                        <a asp-controller="Producto" asp-action="EliminarProducto" asp-route-id="@producto.IdProducto"
                            class="btn btn-danger btn-sm mx-1">
                            <i class="bi bi-trash"></i> Eliminar
                        </a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
@if ((bool)ViewData["esAdmin"])
{
    <div class="text-end mt-3">
        <a asp-controller="Producto" asp-action="AltaProducto" class="btn btn-success btn-lg">
            <i class="bi bi-plus-circle"></i> Agregar producto
        </a>
    </div>
}
