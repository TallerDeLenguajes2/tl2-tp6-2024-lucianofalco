@model ViewAltaPresupuesto

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 bg-light p-5 shadow rounded">
            <h2 class="text-center text-primary mb-4">Modificar Presupuesto</h2>

            <form asp-controller="Presupuesto" asp-action="ModificarPresupuestoPost" method="post">
                <input type="hidden" asp-for="idCliente" />

                <div class="form-group mb-3">
                    <label for="idCliente" class="form-label">Cliente</label>
                    <select name="idCliente" class="form-control" required>
                        <option value="">Seleccione un cliente para asignar presupuesto</option>
                        @foreach (var cliente in (IEnumerable<SelectListItem>)ViewData["Clientes"])
                        {
                            <option value="@cliente.Value">@cliente.Text</option>
                        }
                    </select>
                    <span asp-validation-for="idCliente" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Fecha" class="form-label fw-semibold">Fecha de Creación</label>
                    <input asp-for="Fecha" class="form-control" placeholder="Escribe la nueva fecha de creación" />
                    <span asp-validation-for="Fecha" class="text-danger"></span>
                </div>


                <div class="d-flex justify-content-around mt-4">
                    <button type="submit" class="btn btn-primary px-5" data-bs-toggle="tooltip" data-bs-placement="top" title="Guardar cambios en el presupuesto">
                        Guardar
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-5">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>
