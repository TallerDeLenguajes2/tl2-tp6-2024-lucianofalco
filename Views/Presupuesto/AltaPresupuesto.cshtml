@model ViewAltaPresupuesto //alta_presupuesto viewModel

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 bg-light p-5 shadow rounded">
            <h2 class="text-center text-primary mb-4">Crear Nuevo Presupuesto</h2>

            <form asp-controller="Presupuesto" asp-action="CrearPresupuesto" method="post">
                <div class="form-group mb-3">
                    <label for="idCliente" class="form-label">Cliente</label>
                    <select name="idCliente" class="form-control" required>
                        <option value="">Seleccione un cliente</option>
                        @foreach (var cliente in Model.clientes)
                        {
                            <option value="@cliente.idCliente">@cliente.Nombre</option>
                        }
                    </select>
                    <span asp-validation-for="idCliente" class="text-danger"></span>
                </div>


                <div class="form-group mb-3">
                    <label asp-for="Fecha" class="form-label fw-bold">Fecha de Creación</label>
                    <input asp-for="Fecha" type="date" class="form-control"
                        placeholder="Selecciona la fecha de creación">
                    <span asp-validation-for="Fecha" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-center mt-4">
                    <button type="submit" class="btn btn-success me-3 px-4">Crear Presupuesto</button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>
