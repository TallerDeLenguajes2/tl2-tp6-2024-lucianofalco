@model List<User>

<h2 class="text-primary mb-4">Lista Usuarios</h2>

<table class="table table-striped table-bordered table-hover shadow-sm">
    <thead class="table-dark text-uppercase">
        <tr>
            <th scope="col">#ID</th>
            <th scope="col">Nombre</th>
            <th scope="col">Usuario</th>
            <th scope="col">Password</th>
            <th scope="col">Roll</th>
            <th scope="col" class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <th scope="row" class="text-center text-primary">@u.Id</th>
                <td>@u.Nombre</td>
                <td>@u.Usuario</td>
                <td>@u.Password</td>
                <td>@u.Roll</td>
                <td class="text-center">
                    @if (u.Roll != "Admin")
                    {
                        <a asp-controller="Usuario" asp-action="ModificarUser" asp-route-id="@u.Id"
                            class="btn btn-warning btn-sm mx-1">
                            <i class="bi bi-pencil-square"></i> Editar
                        </a>
                        <a asp-controller="Usuario" asp-action="EliminarUser" asp-route-id="@u.Id"
                            class="btn btn-danger btn-sm mx-1">
                            <i class="bi bi-trash"></i> Eliminar
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="text-end mt-3">
    <a asp-controller="Usuario" asp-action="AltaUser" class="btn btn-success btn-lg">
        <i class="bi bi-plus-circle"></i> Agregar Usuario
    </a>
</div>
