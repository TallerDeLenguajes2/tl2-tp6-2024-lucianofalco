@model ViewUser

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 bg-light p-5 shadow rounded">
            <h2 class="text-center text-primary mb-4">Crear nuevo Usuario</h2>

            <form asp-controller="Usuario" asp-action="CrearUser" method="post">
                <div class="form-group mb-3">
                    <label asp-for="Nombre" class="form-label fw-bold">Nombre: </label>
                    <input asp-for="Nombre" type="text" class="form-control"
                        placeholder="Ej:# Juan Perez">
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Usuario" class="form-label fw-bold">Usuario</label>
                    <input asp-for="Usuario" class="form-control" placeholder="Example@mail.com">
                    <span asp-validation-for="Usuario" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Password" class="form-label fw-bold">Password</label>
                    <input asp-for="Password" class="form-control" placeholder="Ej: correo@ejemplo.com">
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div> 

                <div class="form-group mb-4">
                    <label asp-for="Roll" class="form-label fw-bold">Password</label>
                    <input asp-for="Roll" class="form-control" placeholder="Ej: correo@ejemplo.com">
                    <span asp-validation-for="Roll" class="text-danger"></span>
                </div> 

                <div class="d-flex justify-content-center mt-4">
                    <button type="submit" class="btn btn-success me-3 px-4">Crear Usuario</button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
